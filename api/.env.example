# Copie para .env (que NÃO vai para o Git) e ajuste.
# Em produção (Render), estas variáveis são definidas no painel.

PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Origens que podem chamar a API (CORS e, depois, o WebSocket), separadas por vírgula.
CORS_ORIGINS=http://localhost:5173

# Máximo de enquetes criadas por usuários em memória; ao passar disso, a mais antiga é descartada.
MAX_POLLS=500
